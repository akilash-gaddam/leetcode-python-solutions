class ParkingSystem:

    def __init__(self, big: int, medium: int, small: int):
        self.big=big
        self.medium=medium
        self.small=small
        self.constructor=[self.big,self.medium,self.small]
    def addCar(self, carType: int) -> bool:
        self.carType=carType
        if self.carType==1 and self.constructor[0]>=1:
            self.constructor[0]=self.constructor[0]-1
            return True
        elif self.carType==2 and self.constructor[1]>=1:
            self.constructor[1]=self.constructor[1]-1
            return True
        elif self.carType==3 and self.constructor[2]>=1:
            self.constructor[2]=self.constructor[2]-1
            return True
        else:
            return False
